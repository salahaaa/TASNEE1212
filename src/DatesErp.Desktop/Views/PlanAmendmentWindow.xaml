<Window x:Class="DatesErp.Desktop.Views.PlanAmendmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="طلب تعديل خطة (تغيير صنف العميل)" Width="760" Height="640"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner" Background="#ECE9D8">
    <DockPanel>
        <!-- شريط العنوان -->
        <Border DockPanel.Dock="Top" Padding="12,6">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0A246A" Offset="0"/>
                    <GradientStop Color="#3A6EA5" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <TextBlock x:Name="HeadTitle" DockPanel.Dock="Right" Foreground="White" FontWeight="Bold" FontSize="13"/>
                <TextBlock x:Name="HeadPlan" DockPanel.Dock="Left" Foreground="White" FontSize="12" FontWeight="Bold"/>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#F4F2E8" BorderBrush="#7F9DB9" BorderThickness="0,1,0,0" Padding="10,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="📨 تسجيل طلب التعديل" Style="{StaticResource ErpApproveButton}" Click="Request_Click"/>
                <Button Content="✖ إغلاق" Style="{StaticResource ErpButton}" Margin="8,0,0,0" Click="Close_Click"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14">
                <!-- 1) اختيار بند الخطة المستهدف -->
                <TextBlock Text="1) بند الخطة المستهدف بالتعديل" FontWeight="Bold" Foreground="#0A246A" Margin="0,0,0,6"/>
                <ComboBox x:Name="ItemBox" DisplayMemberPath="Label" SelectedValuePath="ItemId"
                          SelectionChanged="ItemBox_SelectionChanged" Height="30" FontSize="12"/>

                <!-- لافتة حالة التنفيذ + حماية المنفذ -->
                <Border x:Name="ExecBanner" Background="#FEF9E7" BorderBrush="#F0D58C" BorderThickness="1" Padding="10,8" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock x:Name="ExecText" FontWeight="Bold" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ProtectText" Foreground="#7A5C00" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ملخص البند الأصلي (قديم / منفذ / متبقي) -->
                <Border Background="#F8FAFC" BorderBrush="#7F9DB9" BorderThickness="1" Padding="10,8" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="الصنف الحالي" FontSize="10.5" Foreground="#555"/>
                            <TextBlock x:Name="OldProductText" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="المخطط (كجم)" FontSize="10.5" Foreground="#555"/>
                            <TextBlock x:Name="PlannedText" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="المنفذ فعلياً (كجم)" FontSize="10.5" Foreground="#555"/>
                            <TextBlock x:Name="ExecutedText" FontSize="13" FontWeight="Bold" Foreground="#1E6B3A"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="المتبقي (كجم)" FontSize="10.5" Foreground="#555"/>
                            <TextBlock x:Name="RemainingText" FontSize="13" FontWeight="Bold" Foreground="#B45309"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2) الصنف الجديد والعبوة والكمية -->
                <TextBlock Text="2) الصنف الجديد (بديل الصنف الحالي)" FontWeight="Bold" Foreground="#0A246A" Margin="0,16,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="الصنف الجديد" FontSize="10.5" Foreground="#555"/>
                        <ComboBox x:Name="NewProductBox" DisplayMemberPath="ProductNameAr" SelectedValuePath="Id" Height="30" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="العبوة (اختياري — افتراضياً عبوة البند الأصلي)" FontSize="10.5" Foreground="#555"/>
                        <ComboBox x:Name="NewPackBox" DisplayMemberPath="PackageNameAr" SelectedValuePath="Id" Height="30" FontSize="12"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="الكمية الجديدة للصنف الجديد (كجم) — فارغ = المتبقي كاملاً" FontSize="10.5" Foreground="#555" Margin="0,12,0,4"/>
                <TextBox x:Name="NewQtyBox" FontSize="13" Padding="6,4" TextChanged="NewQtyBox_TextChanged"/>

                <!-- 3) السبب -->
                <TextBlock Text="3) سبب التعديل (إلزامي — يُسجَّل للتدقيق)" FontWeight="Bold" Foreground="#0A246A" Margin="0,16,0,6"/>
                <TextBox x:Name="ReasonBox" FontSize="13" Padding="6,4" TextWrapping="Wrap" MinHeight="70" AcceptsReturn="True"/>

                <TextBlock x:Name="HintText" FontSize="11" Foreground="#7A5C00" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
