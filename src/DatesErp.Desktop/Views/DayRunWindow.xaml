<Window x:Class="DatesErp.Desktop.Views.DayRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تشغيل اليوم" Width="1150" Height="640"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner">
    <DockPanel Background="#ECE9D8">
        <!-- شريط العنوان -->
        <Border DockPanel.Dock="Top" Padding="12,6">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0A246A" Offset="0"/>
                    <GradientStop Color="#3A6EA5" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <TextBlock x:Name="HeadTitle" DockPanel.Dock="Right" Foreground="White" FontWeight="Bold" FontSize="13"/>
                <TextBlock x:Name="HeadState" DockPanel.Dock="Left" Foreground="White" FontSize="12" FontWeight="Bold"/>
            </DockPanel>
        </Border>

        <!-- لافتة تعثر (تاريخ مضى بلا تشغيل) -->
        <Border x:Name="OverdueBanner" DockPanel.Dock="Top" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="0,0,0,1" Padding="12,6">
            <TextBlock x:Name="OverdueText" Foreground="#991B1B" FontWeight="Bold" FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <!-- شريط الإجراء -->
        <Border DockPanel.Dock="Bottom" Background="#F4F2E8" BorderBrush="#7F9DB9" BorderThickness="0,1,0,0" Padding="10,8">
            <DockPanel>
                <Button x:Name="BtnCreate" Content="🏭 إنشاء أمر التشغيل" Style="{StaticResource ErpApproveButton}" DockPanel.Dock="Left" Click="Create_Click"/>
                <Button Content="✖ إغلاق" Style="{StaticResource ErpButton}" DockPanel.Dock="Left" Margin="8,0,0,0" Click="Close_Click"/>
                <StackPanel x:Name="TotalsPanel" DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock x:Name="TotalsText" FontSize="12.5" FontWeight="Bold" Foreground="#0A246A" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <DataGrid x:Name="RowsGrid" Margin="8" AutoGenerateColumns="False" RowHeight="30" FontSize="11.5"
                  CellEditEnding="RowsGrid_CellEditEnding" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="تشغيل" Binding="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                <DataGridTextColumn Header="العميل 👤" Binding="{Binding CustomerName}" Width="140" IsReadOnly="True"/>
                <DataGridTextColumn Header="الصنف 🏷️" Binding="{Binding ProductName}" Width="150" IsReadOnly="True"/>
                <DataGridTextColumn Header="العبوة" Binding="{Binding PackName}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="الدفعة" Binding="{Binding LotCode}" Width="90" IsReadOnly="True"/>
                <DataGridTextColumn Header="الوردية" Binding="{Binding ShiftName}" Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="الخط" Binding="{Binding LineName}" Width="90" IsReadOnly="True"/>
                <DataGridTextColumn Header="المخطط (كرتون)" Binding="{Binding PlannedCartons}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="أوامر سابقة (كرتون)" Binding="{Binding OrderedCartons}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="المتبقي (كرتون)" Binding="{Binding RemainingCartons}" Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="كراتين الأمر ✍️" Binding="{Binding OrderCartons, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                <DataGridTextColumn Header="الوزن المكافئ (كجم)" Binding="{Binding OrderKg}" Width="130" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
