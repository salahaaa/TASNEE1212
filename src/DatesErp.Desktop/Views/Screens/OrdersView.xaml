<UserControl x:Class="DatesErp.Desktop.Views.Screens.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <local:StatusToBrushConverter x:Key="StatusBrush" xmlns:local="clr-namespace:DatesErp.Desktop.Views.Screens"/>
        <local:ProgressPctConverter x:Key="ProgressPct" xmlns:local="clr-namespace:DatesErp.Desktop.Views.Screens"/>
    </UserControl.Resources>
    <Grid>
    <!-- ══ منطقة المستند: أمر الإنتاج يظهر كاملاً في الواجهة الرئيسية نفسها (§5/§9) ══ -->
    <!-- §بلا تمرير: شريط الرجوع ثابت والمستند يملأ الواجهة -->
    <DockPanel x:Name="DocArea" Visibility="Collapsed" LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="⬅ العودة إلى البحث وقائمة الأوامر" Style="{StaticResource ErpButton}" Click="BackToList_Click" FontSize="13.5" Padding="12,6"/>
            <TextBlock Text="المستند محفوظ في النظام — خروجه من هنا لا يحذفه، ويُستعاد في أي وقت عبر «بحث»"
                       FontSize="12.5" Foreground="#555" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="DocHost"/>
        </ScrollViewer>
    </DockPanel>

    <!-- §بلا تمرير: البحث أعلى · أوامر العمليات ثابتة أسفل · الجدول يأخذ كل المساحة -->
    <DockPanel x:Name="ListArea" LastChildFill="True">

            <!-- ══ منطقة البحث والتصفية ══ -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <Border Style="{StaticResource SecHeader}" Margin="-12,-12,-12,8">
                        <TextBlock Text="🔎 البحث والتصفية — أوامر الإنتاج مرتبطة بخطة الإنتاج: العميل والصنف والمنتج والكمية تُجلب من الخطة" FontSize="12" FontWeight="Bold" Foreground="#0A246A"/>
                    </Border>
                    <WrapPanel>
                        <StackPanel Margin="0,0,14,6">
                            <TextBlock Text="رقم أمر الإنتاج:" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="FOrderNo" Width="130"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,14,6">
                            <TextBlock Text="رقم خطة الإنتاج:" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="FPlanNo" Width="130"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,14,6">
                            <TextBlock Text="العميل:" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="FCustomer" Width="170"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,14,6">
                            <TextBlock Text="الصنف/المنتج:" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="FProduct" Width="170"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,14,6">
                            <TextBlock Text="من تاريخ:" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="FDateFrom" Width="130"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,14,6">
                            <TextBlock Text="إلى تاريخ:" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="FDateTo" Width="130"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,14,6">
                            <TextBlock Text="الوردية:" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="FShift" Width="150"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,14,6">
                            <TextBlock Text="حالة الأمر:" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="FStatus" Width="140"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,6" VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="🔍 بحث" Style="{StaticResource ErpPrimaryButton}" Click="Search_Click"/>
                                <Button Content="↺ إعادة تعيين" Style="{StaticResource ErpButton}" Click="Reset_Click" Margin="6,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ══ ملخص الحالات ══ -->
            <WrapPanel x:Name="ChipsPanel" DockPanel.Dock="Top" Margin="0,0,0,8"/>

            <!-- ══ جدول أوامر الإنتاج ══ -->
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="العمليات على الأمر المحدد — الصلاحيات تُفحص في الواجهة وفي الـ Backend معاً" FontSize="12" Foreground="#555" Margin="0,0,0,6"/>
                    <WrapPanel>
                        <Button x:Name="NewBtn" Content="➕ أمر إنتاج جديد" Style="{StaticResource ErpApproveButton}" Click="NewOrder_Click" Margin="0,0,6,6"/>
                        <Button x:Name="IssuePlanBtn" Content="📋 ترحيل خطة إلى أوامر" Style="{StaticResource ErpPrimaryButton}" Click="IssuePlan_Click" Margin="0,0,6,6"
                                ToolTip="المرحلة التالية بعد اعتماد الخطة: ترحيل بنودها ذات المتبقي إلى أوامر — أمر لكل (تاريخ × وردية × خط)"/>
                        <Button x:Name="EditOrderBtn" Content="✏️ تعديل الأمر" Style="{StaticResource ErpPrimaryButton}" Click="EditOrder_Click" Margin="0,0,6,6"/>
                        <Button x:Name="DeleteOrderBtn" Content="🗑️ حذف الأمر" Style="{StaticResource ErpDangerButton}" Click="DeleteOrder_Click" Margin="0,0,6,6"/>
                        <Button x:Name="ApproveBtn" Content="🔒 اعتماد" Style="{StaticResource ErpPrimaryButton}" Click="Approve_Click" Margin="0,0,6,6"/>
                        <Button x:Name="UnapproveBtn" Content="↩ إلغاء الاعتماد" Style="{StaticResource ErpButton}" Click="Unapprove_Click" Margin="0,0,6,6"/>
                        <Button x:Name="StartBtn" Content="🏭 بدء الإنتاج" Style="{StaticResource ErpApproveButton}" Click="Start_Click" Margin="0,0,6,6"/>
                        <Button x:Name="StopBtn" Content="⏸ إيقاف" Style="{StaticResource ErpDangerButton}" Click="Stop_Click" Margin="0,0,6,6"/>
                        <Button x:Name="ResumeBtn" Content="▶ استئناف" Style="{StaticResource ErpPrimaryButton}" Click="Resume_Click" Margin="0,0,6,6"/>
                        <Button x:Name="CloseDayBtn" Content="🔒 إقفال يوم الإنتاج" Style="{StaticResource ErpPrimaryButton}" Click="CloseDay_Click" Margin="0,0,6,6"/>
                        <Button x:Name="CancelOrderBtn" Content="✖ إلغاء الأمر" Style="{StaticResource ErpDangerButton}" Click="CancelOrder_Click" Margin="0,0,6,6"/>
                        <Button Content="🖨 طباعة" Style="{StaticResource ErpButton}" Click="Print_Click" Margin="0,0,6,6"/>
                        <Button Content="📄 تصدير PDF" Style="{StaticResource ErpButton}" Click="Pdf_Click" Margin="0,0,6,6"/>
                        <Button Content="🔄 تحديث" Style="{StaticResource ErpButton}" Click="Refresh_Click" Margin="0,0,6,6"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource WhiteCard}">
                <DockPanel LastChildFill="True">
                    <TextBlock x:Name="ListHint" DockPanel.Dock="Top" Text="نتائج البحث — أوامر الإنتاج (الشاشة تفتح فارغة: اضغط «بحث» لعرض الأوامر، ونقرتان متتاليتان على أي أمر تفتحانه كاملاً في هذه الواجهة)" FontWeight="Bold" FontSize="12" Foreground="#0A246A" Margin="0,0,0,6" TextWrapping="Wrap"/>
                    <DataGrid x:Name="OrdersGrid" RowHeight="32" FontSize="13.5" ColumnHeaderHeight="38" MouseDoubleClick="OrdersGrid_DoubleClick" SelectionChanged="OrdersGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم الأمر" Binding="{Binding OrderNumber}" Width="110"/>
                            <DataGridTextColumn Header="الخطة" Binding="{Binding PlanNumber}" Width="110"/>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding Date}" Width="90"/>
                            <DataGridTextColumn Header="العميل" Binding="{Binding Customer}" Width="130"/>
                            <DataGridTextColumn Header="الصنف المستلم" Binding="{Binding RawName}" Width="110"/>
                            <DataGridTextColumn Header="المنتج النهائي" Binding="{Binding ProductNames}" Width="150"/>
                            <DataGridTextColumn Header="المخططة (كجم)" Binding="{Binding PlannedKg}" Width="95"/>
                            <DataGridTextColumn Header="المنتجة (كجم)" Binding="{Binding ProducedKg}" Width="95"/>
                            <DataGridTextColumn Header="المتبقية (كجم)" Binding="{Binding RemainingKg}" Width="95"/>
                            <DataGridTextColumn Header="الوردية" Binding="{Binding ShiftName}" Width="100"/>
                            <DataGridTextColumn Header="الخط" Binding="{Binding LineName}" Width="80"/>
                            <DataGridTextColumn Header="وقت البداية" Binding="{Binding StartTime}" Width="110"/>
                            <DataGridTextColumn Header="النهاية المتوقع" Binding="{Binding ExpectedEnd}" Width="110"/>
                            <DataGridTemplateColumn Header="الحالة" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusKey, Converter={StaticResource StatusBrush}}" CornerRadius="8" Padding="6,2" Margin="2" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding StatusAr}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="التقدم" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,0">
                                            <ProgressBar Height="14" Maximum="100" Value="{Binding ProgressPct, Mode=OneWay}"/>
                                            <TextBlock Text="{Binding ProgressPct, Converter={StaticResource ProgressPct}}" HorizontalAlignment="Center" FontSize="10" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- ══ أوامر العمليات — ثابتة أسفل الواجهة فلا يُصعد إليها ══ -->

    </DockPanel>
    </Grid>
</UserControl>
