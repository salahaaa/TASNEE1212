<UserControl x:Class="DatesErp.Desktop.Views.Screens.CartonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <TabControl>
        <TabItem Header="📦 الرصيد والحركات">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="170"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource WhiteCard}" Margin="0,0,0,8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="أرصدة الكرتون الفارغ حسب المخزن (كرتون)" FontWeight="Bold" Foreground="#0A246A" Margin="0,0,0,4"/>
                        <DataGrid x:Name="BalGrid" AutoGenerateColumns="False" RowHeight="28" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="المخزن" Binding="{Binding Warehouse}" Width="*"/>
                                <DataGridTextColumn Header="الصنف" Binding="{Binding Product}" Width="*"/>
                                <DataGridTextColumn Header="الرصيد (كرتون)" Binding="{Binding Cartons}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource WhiteCard}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="📜 دفتر حركات الكرتون (تولّد/بيع/عدّ)" FontWeight="Bold" Foreground="#0A246A" VerticalAlignment="Center"/>
                            <Button Content="تحديث" Style="{StaticResource ErpButton}" Click="Refresh_Click" Margin="14,0,0,0"/>
                        </StackPanel>
                        <DataGrid x:Name="MovGrid" AutoGenerateColumns="False" RowHeight="26" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="التاريخ" Binding="{Binding Date}" Width="100"/>
                                <DataGridTextColumn Header="الحركة" Binding="{Binding Txn}" Width="90"/>
                                <DataGridTextColumn Header="المستند المرجعي" Binding="{Binding Ref}" Width="140"/>
                                <DataGridTextColumn Header="المخزن" Binding="{Binding Warehouse}" Width="*"/>
                                <DataGridTextColumn Header="وارد" Binding="{Binding Inb}" Width="70"/>
                                <DataGridTextColumn Header="صادر/تسوية" Binding="{Binding Outb}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </TabItem>

        <TabItem Header="🔢 عدّ فعلي">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="مخزن العدّ *:" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CountWhBox" Width="220" DisplayMemberPath="WarehouseNameAr" SelectedValuePath="Id"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="تاريخ العدّ:" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="CountDateBox" Width="140"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="الصنف (004):" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CountProdBox" Width="220" DisplayMemberPath="ProductNameAr" SelectedValuePath="Id"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="العدّ الفعلي (كرتون) *:" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="CountedBox" Width="110" Text="0"/>
                        </StackPanel>
                        <Button Content="➕ إضافة سطر" Style="{StaticResource ErpPrimaryButton}" Click="AddCountRow_Click" VerticalAlignment="Bottom"/>
                        <Button Content="💾 تسجيل سند العدّ وتقييد الفروق" Style="{StaticResource ErpApproveButton}" Click="SaveCount_Click" VerticalAlignment="Bottom" Margin="10,0,0,0"/>
                    </WrapPanel>
                    <DataGrid x:Name="CountGrid" Height="200" RowHeight="28" IsReadOnly="True"/>
                    <TextBlock x:Name="CountHint" Text="الفرق (الفعلي − الدفتري) يُقيَّد حركة تسوية آلياً ويُوثق في السجل." Foreground="#555" FontSize="11" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </TabItem>

        <TabItem Header="💰 بيع الكرتون">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="العميل المشتري (اختياري):" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="SaleCustBox" Width="220" DisplayMemberPath="CustomerName" SelectedValuePath="Id"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="مخزن الصرف *:" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="SaleWhBox" Width="220" DisplayMemberPath="WarehouseNameAr" SelectedValuePath="Id"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="سعر الكرتون:" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="PriceBox" Width="100" Text="0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="الصنف (004):" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="SaleProdBox" Width="220" DisplayMemberPath="ProductNameAr" SelectedValuePath="Id"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="كراتين البيع *:" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="SaleQtyBox" Width="100" Text="0"/>
                        </StackPanel>
                        <Button Content="➕ إضافة سطر" Style="{StaticResource ErpPrimaryButton}" Click="AddSaleRow_Click" VerticalAlignment="Bottom"/>
                        <Button Content="💾 حفظ سند البيع" Style="{StaticResource ErpApproveButton}" Click="SaveSale_Click" VerticalAlignment="Bottom" Margin="10,0,0,0"/>
                        <Button Content="🖨 طباعة السند" Style="{StaticResource ErpButton}" Click="PrintSale_Click" VerticalAlignment="Bottom" Margin="10,0,0,0"/>
                    </WrapPanel>
                    <DataGrid x:Name="SaleGrid" Height="200" RowHeight="28" IsReadOnly="True"/>
                    <TextBlock x:Name="SaleTotal" Text="الإجمالي: 0" FontWeight="Bold" Foreground="#14532D" FontSize="13" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </TabItem>
    </TabControl>
</UserControl>