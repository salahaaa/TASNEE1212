<UserControl x:Class="DatesErp.Desktop.Views.Screens.RawTreatmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <!-- §المعالجة والتعقيم — شاشة تشغيل الدورة: بدء · إفراج · رفض · متابعة. -->
    <DockPanel Margin="8">

        <!-- ═ شريط الحالة: الأرقام الأربعة التي يسأل عنها المستخدم ═ -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="🧪 معالجة وتعقيم الخام" FontWeight="Bold"
                           FontSize="15" Foreground="#0A246A" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <WrapPanel x:Name="CountersPanel" Orientation="Horizontal"/>
            </DockPanel>
        </Border>

        <!-- ═ المرشحات ═ -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,8">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="الحالة:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,6,0"/>
                <ComboBox x:Name="StatusFilter" Width="150" SelectionChanged="Status_Changed" Margin="0,0,16,0"/>
                <CheckBox x:Name="OverdueOnly" Content="المتأخرة فقط ⚠️" VerticalAlignment="Center"
                          Checked="Overdue_Toggled" Unchecked="Overdue_Toggled" Margin="0,0,16,0"/>
                <Button Content="🔄 تحديث" Style="{StaticResource ErpButton}" Click="Refresh_Click" Margin="0,0,8,0"/>
                <Button x:Name="StartBtn" Content="➕ بدء معالجة" Style="{StaticResource ErpApproveButton}"
                        Click="Start_Click" Margin="0,0,8,0"/>
                <Button x:Name="ReleaseBtn" Content="✅ إفراج" Style="{StaticResource ErpApproveButton}"
                        Click="Release_Click" Margin="0,0,8,0"/>
                <Button x:Name="RejectBtn" Content="⛔ رفض" Style="{StaticResource ErpDangerButton}"
                        Click="Reject_Click" Margin="0,0,8,0"/>
                <Button x:Name="CancelBtn" Content="↩ إلغاء البدء" Style="{StaticResource ErpButton}"
                        Click="CancelStart_Click"/>
            </WrapPanel>
        </Border>

        <!-- ═ الجدول ═ -->
        <Border Style="{StaticResource Card}">
            <Grid>
                <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" SelectionMode="Single"
                          CanUserAddRows="False" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="رقم المعالجة" Binding="{Binding TreatmentNo}" Width="130"/>
                        <DataGridTextColumn Header="الدفعة" Binding="{Binding LotCode}" Width="110"/>
                        <DataGridTextColumn Header="الصنف" Binding="{Binding ProductName}" Width="150"/>
                        <DataGridTextColumn Header="نوع المعالجة" Binding="{Binding TreatmentTypeName}" Width="110"/>
                        <DataGridTextColumn Header="الكمية (كجم)" Binding="{Binding QtyKg, StringFormat=N1}" Width="100"/>
                        <DataGridTextColumn Header="الطرود" Binding="{Binding PackageCount}" Width="70"/>
                        <DataGridTextColumn Header="البداية" Binding="{Binding StartedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="120"/>
                        <DataGridTextColumn Header="المدة" Binding="{Binding DurationText}" Width="90"/>
                        <DataGridTextColumn Header="الجاهزية المتوقعة" Binding="{Binding ExpectedReadyAt, StringFormat=dd/MM/yyyy HH:mm}" Width="130"/>
                        <DataGridTextColumn Header="أُفرج (كجم)" Binding="{Binding ReleasedQtyKg, StringFormat=N1}" Width="95"/>
                        <DataGridTextColumn Header="مرفوض (كجم)" Binding="{Binding RejectedQtyKg, StringFormat=N1}" Width="95"/>
                        <DataGridTextColumn Header="المتبقي (كجم)" Binding="{Binding RemainingQtyKg, StringFormat=N1}" Width="100"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding StatusText}" Width="130"/>
                        <DataGridTextColumn Header="المسؤول" Binding="{Binding ResponsibleName}" Width="120"/>
                        <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap" TextAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
