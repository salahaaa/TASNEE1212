<UserControl x:Class="DatesErp.Desktop.Views.Screens.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <!--
      §B90 — التصميم المهني: معرض تقارير مصنّف قابل للبحث + مساحة عمل عريضة.
      عند تشغيل التقرير يختفي المعرض ويمتد التقرير على كامل الواجهة،
      وزر «رجوع» يعيد المعرض. والنقر المزدوج على أي تقرير يشغّله مباشرة.
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ListCol" Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══ معرض التقارير المصنّف — بحث + بطاقات، يختفي عند تشغيل التقرير ══ -->
        <Border x:Name="CatalogPanel" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource SecHeader}" Margin="-12,-12,-12,8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="📈 مركز التقارير" FontSize="13" FontWeight="Bold" Foreground="#0A246A"/>
                        <TextBlock x:Name="ReportsCount" DockPanel.Dock="Left" Text="" FontSize="11" Foreground="#5F6368" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="🔍 ابحث باسم التقرير:" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="CatalogSearchBox" Width="190" TextChanged="CatalogSearch_Changed" VerticalAlignment="Center"
                             ToolTip="فلترة لحظية لقائمة التقارير بالاسم"/>
                </StackPanel>
                <ListBox x:Name="ReportsList" SelectionChanged="Report_Selected" MouseDoubleClick="Report_DoubleClick"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Background="#0A246A" Padding="8,5" Margin="0,8,0,4" CornerRadius="4">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="White"/>
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="card" BorderBrush="#D4D0C8" BorderThickness="1" CornerRadius="4" Background="White" Padding="8,6" Margin="0,0,0,4">
                                <StackPanel>
                                    <TextBlock Text="{Binding TitleAr}" FontSize="14" FontWeight="Bold" Foreground="#0A246A" TextWrapping="Wrap"/>
                                    <TextBlock FontSize="11.5" Foreground="#5F6368" Margin="0,2,0,0"
                                               Text="{Binding Parameters.Count, StringFormat='{}{0} فلتر — نقرتان للتشغيل المباشر'}"/>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                    <Setter TargetName="card" Property="BorderBrush" Value="#C9A227"/>
                                    <Setter TargetName="card" Property="BorderThickness" Value="2"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ══ منطقة التقرير ══ -->
        <Border x:Name="ReportPanel" Grid.Column="1" Style="{StaticResource Card}">
            <DockPanel>
                <!-- §B90 — الترويسة: رجوع + العنوان والوصف + إجراءات الإخراج -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button x:Name="BackBtn" DockPanel.Dock="Right" Content="→ رجوع لمعرض التقارير"
                            Style="{StaticResource ErpButton}" Click="Back_Click"
                            Visibility="Collapsed" Padding="12,6" FontSize="13.5" Margin="0,0,0,0" VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="🖨 طباعة" Style="{StaticResource ErpButton}" Click="Print_Click" Margin="0,0,8,0" FontSize="13" Padding="10,5"/>
                        <Button Content="📄 PDF" Style="{StaticResource ErpButton}" Click="Pdf_Click" Margin="0,0,8,0" FontSize="13" Padding="10,5"/>
                        <Button Content="📊 Excel" Style="{StaticResource ErpButton}" Click="Excel_Click" FontSize="13" Padding="10,5"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock x:Name="ReportTitle" Text="اختر تقريراً من المعرض — نقرتان لتشغيله مباشرة"
                                   FontSize="19" FontWeight="Bold" Foreground="#0A246A" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ReportSub" Text="" FontSize="11.5" Foreground="#5F6368" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>

                <!-- §B90 — شريط الفلاتر: بطاقة مميزة بترويسة + زر تشغيل بارز -->
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,8">
                    <StackPanel>
                        <Border Style="{StaticResource SecHeader}" Margin="-12,-12,-12,8">
                            <TextBlock Text="🔎 فلاتر التقرير — حدد ثم اضغط تشغيل" FontSize="12" FontWeight="Bold" Foreground="#0A246A"/>
                        </Border>
                        <DockPanel>
                            <Button x:Name="RunBtn" DockPanel.Dock="Left" Content="▶ تشغيل التقرير" Style="{StaticResource ErpApproveButton}" Click="Run_Click" FontSize="14" Padding="18,8" VerticalAlignment="Bottom"/>
                            <WrapPanel x:Name="ParamsPanel">
                                <TextBlock Text="اختر تقريراً لعرض فلاتره هنا." FontSize="13.5" Foreground="#555" VerticalAlignment="Center"/>
                            </WrapPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- بطاقات المؤشرات -->
                <ScrollViewer DockPanel.Dock="Top" MaxHeight="120" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6">
                    <WrapPanel x:Name="KpiPanel"/>
                </ScrollViewer>

                <!-- العدّاد والبحث -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <TextBlock x:Name="RowsCount" Text="" FontSize="13" Foreground="#555" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔎 بحث سريع في النتائج:" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="QuickSearchBox" Width="340" FontSize="13.5" TextChanged="QuickSearch_Changed"
                                 ToolTip="فلترة لحظية لكل أعمدة النتيجة — تعمل مع كل التقارير"/>
                    </StackPanel>
                </DockPanel>

                <!-- الجدول — يأخذ كل المساحة المتبقية، وعرضه كامل الواجهة -->
                <DataGrid x:Name="ReportGrid" FontSize="14" RowHeight="34"
                          ColumnHeaderHeight="40" GridLinesVisibility="All"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
