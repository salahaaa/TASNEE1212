<UserControl x:Class="DatesErp.Desktop.Views.Screens.ShipmentReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <!-- §B101 — تقرير حركة شحنة العميل (تصميم مستقل): رأس الشحنة ← سلسلة المراحل ←
         مؤشرات ← أوامر (تفاصيل عند نقر مزدوج) ← تسليمات العميل. تصدير/طباعة بنفس البيانات. -->
    <DockPanel LastChildFill="True" Margin="8">

        <!-- شريط الفلاتر + التصدير -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,6">
            <WrapPanel>
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="خطة الإنتاج:" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="PlanBox" Width="340" SelectionChanged="Filter_Changed"/>
                </StackPanel>
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="العميل:" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="CustBox" Width="190" SelectionChanged="Filter_Changed"/>
                </StackPanel>
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="الصنف:" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="ProdBox" Width="190" SelectionChanged="Filter_Changed"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="🔄 تحديث" Style="{StaticResource ErpButton}" Click="Refresh_Click" Margin="0,0,8,0"/>
                    <Button Content="🖨️ طباعة" Style="{StaticResource ErpButton}" Click="Print_Click" Margin="0,0,8,0"/>
                    <Button Content="📄 PDF" Style="{StaticResource ErpButton}" Click="Pdf_Click" Margin="0,0,8,0"/>
                    <Button Content="📊 Excel" Style="{StaticResource ErpButton}" Click="Excel_Click"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- رأس الشحنة -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,6">
            <StackPanel>
                <DockPanel>
                    <Border x:Name="StatusChip" CornerRadius="4" Padding="10,4" HorizontalAlignment="Left"
                            Background="#F3F4F6" VerticalAlignment="Center">
                        <TextBlock x:Name="HStatus" Text="—" FontWeight="Bold" FontSize="14" Foreground="#4B5563"/>
                    </Border>
                    <TextBlock x:Name="HTitle" FontSize="16" FontWeight="Bold" Foreground="#0A246A" VerticalAlignment="Center"
                               Text="اختر خطة الإنتاج لعرض شحنتها"/>
                </DockPanel>
                <WrapPanel Margin="0,8,0,0">
                    <StackPanel Margin="0,0,18,4">
                        <TextBlock Text="أول دخول (خطة):" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="HEntry" FontWeight="SemiBold" Foreground="#1F2937"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,18,4">
                        <TextBlock Text="دخلت الإنتاج:" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="HProdDate" FontWeight="SemiBold" Foreground="#1F2937"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,18,4">
                        <TextBlock Text="شُغّلت بـ:" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="HOrders" FontWeight="SemiBold" Foreground="#1F2937"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,18,4">
                        <TextBlock Text="تاريخ التشغيل المجدول:" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="HScheduled" FontWeight="SemiBold" Foreground="#1F2937"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,18,4">
                        <TextBlock Text="أيام الدورة (اعتماد ← آخر تسليم):" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="HCycle" FontWeight="SemiBold" Foreground="#14532D"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,18,4">
                        <TextBlock Text="الخطوة الحالية:" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="HCurrent" FontWeight="SemiBold" Foreground="#B45309"/>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- سلسلة المراحل (5 رقائق) -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,6">
            <StackPanel x:Name="StepperPanel" Orientation="Horizontal" HorizontalAlignment="Center"/>
        </Border>

        <!-- مؤشرات الإجماليات -->
        <Border DockPanel.Dock="Top" Background="#F4F2E8" BorderBrush="#B8B5A0" BorderThickness="1" Padding="8,6" Margin="0,0,0,6">
            <UniformGrid Columns="5">
                <StackPanel Margin="4,0">
                    <TextBlock Text="المخطط (كجم)" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="KPlanned" FontSize="16" FontWeight="Bold" Foreground="#0A246A" HorizontalAlignment="Center"/>
                    <ProgressBar x:Name="PPlanned" Height="6" Margin="0,4,0,0" Maximum="100"/>
                </StackPanel>
                <StackPanel Margin="4,0">
                    <TextBlock Text="المُنتَج (كجم)" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="KProduced" FontSize="16" FontWeight="Bold" Foreground="#1F2937" HorizontalAlignment="Center"/>
                    <ProgressBar x:Name="PProduced" Height="6" Margin="0,4,0,0" Maximum="100"/>
                </StackPanel>
                <StackPanel Margin="4,0">
                    <TextBlock Text="المقبول — جودة (كجم)" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="KAccepted" FontSize="16" FontWeight="Bold" Foreground="#0284C7" HorizontalAlignment="Center"/>
                    <ProgressBar x:Name="PAccepted" Height="6" Margin="0,4,0,0" Maximum="100"/>
                </StackPanel>
                <StackPanel Margin="4,0">
                    <TextBlock Text="المستلم — مخزن التام (كجم)" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="KReceived" FontSize="16" FontWeight="Bold" Foreground="#15803D" HorizontalAlignment="Center"/>
                    <ProgressBar x:Name="PReceived" Height="6" Margin="0,4,0,0" Maximum="100"/>
                </StackPanel>
                <StackPanel Margin="4,0">
                    <TextBlock Text="المُسلَّم للعميل (كجم)" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="KDelivered" FontSize="16" FontWeight="Bold" Foreground="#D97706" HorizontalAlignment="Center"/>
                    <ProgressBar x:Name="PDelivered" Height="6" Margin="0,4,0,0" Maximum="100"/>
                </StackPanel>
            </UniformGrid>
        </Border>

        <!-- أزرار أسفل التقرير -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,6,0,0">
            <DockPanel>
                <TextBlock x:Name="CountLabel" VerticalAlignment="Center" Foreground="#6B7280" Margin="10,0,0,0"/>
                <TextBlock Text="تصدير:  🖨️ طباعة · 📄 PDF · 📊 Excel  (نفس بيانات التقرير أعلاه)" VerticalAlignment="Center" Foreground="#9CA3AF"/>
            </DockPanel>
        </Border>

        <!-- منطقة التفاصيل: أوامر + تفاصيل الأمر + تسليمات -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- الأوامر -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="🏭 أوامر الإنتاج (مخرجات كل أمر) — نقر مزدوج: التفاصيل الكاملة"
                               FontWeight="Bold" Foreground="#0A246A" Margin="2,0,0,4"/>
                    <DataGrid x:Name="OrdersGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              CanUserAddRows="False" MaxHeight="220"
                              MouseDoubleClick="OrdersGrid_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Seq}" Width="34"/>
                            <DataGridTextColumn Header="رقم الأمر" Binding="{Binding OrderNumber}" Width="110"/>
                            <DataGridTextColumn Header="تاريخ الإنتاج" Binding="{Binding ProductionDate}" Width="86"/>
                            <DataGridTextColumn Header="الوردية / الخط" Binding="{Binding ShiftLine}" Width="130"/>
                            <DataGridTextColumn Header="الحالة" Binding="{Binding StatusAr}" Width="90"/>
                            <DataGridTextColumn Header="مخطط (كجم)" Binding="{Binding PlannedKg}" Width="80"/>
                            <DataGridTextColumn Header="منتَج (كجم)" Binding="{Binding ProducedKg}" Width="80"/>
                            <DataGridTextColumn Header="التشغيل (جلسات/خسارة/خام)" Binding="{Binding ProductionText}" Width="*"/>
                            <DataGridTextColumn Header="فحص الجودة (مقبول/مرفوض/قرار)" Binding="{Binding QualityText}" Width="*"/>
                            <DataGridTextColumn Header="تسليم الإنتاج للمخزن" Binding="{Binding WarehouseText}" Width="*"/>
                            <DataGridTextColumn Header="استلام مخزن التام" Binding="{Binding ReceiptText}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- تفاصيل الأمر المحدد -->
            <Border x:Name="OrderDetailBox" Grid.Row="1" Visibility="Collapsed" Background="#EFF6FF"
                    BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock x:Name="OrderDetailTitle" FontWeight="Bold" Foreground="#1E40AF" FontSize="13.5" Margin="0,0,0,4"/>
                    <WrapPanel>
                        <StackPanel Margin="0,0,18,4">
                            <TextBlock Text="أُنشئ:" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="ODCreated" Foreground="#1F2937"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,18,4">
                            <TextBlock Text="عُتمد/صُرف:" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="ODApproved" Foreground="#1F2937"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,18,4">
                            <TextBlock Text="الإقفال:" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="ODClosed" Foreground="#6B7280"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,18,4">
                            <TextBlock Text="الوردية/الخط:" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="ODShift" Foreground="#1F2937"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,18,4">
                            <TextBlock Text="مخطط ← مُنتج (حصة الشحنة):" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="ODQty" Foreground="#1F2937"/>
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock x:Name="ODProduction" Margin="0,2,0,0" Foreground="#1F2937" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ODQuality" Margin="0,2,0,0" Foreground="#1F2937" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ODWarehouse" Margin="0,2,0,0" Foreground="#1F2937" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ODReceipt" Margin="0,2,0,0" Foreground="#1F2937" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- تسليمات العميل -->
            <Border Grid.Row="2" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="🚚 تسليمات العميل — حتى اكتمال الشحنة"
                               FontWeight="Bold" Foreground="#0A246A" Margin="2,0,0,4"/>
                    <DataGrid x:Name="CdsGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Seq}" Width="34"/>
                            <DataGridTextColumn Header="رقم المستند" Binding="{Binding DocNumber}" Width="120"/>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding DateText}" Width="90"/>
                            <DataGridTextColumn Header="الكمية (كجم)" Binding="{Binding QtyKg}" Width="86"/>
                            <DataGridTextColumn Header="الكراتين" Binding="{Binding Cartons}" Width="70"/>
                            <DataGridTextColumn Header="الحالة" Binding="{Binding StatusAr}" Width="130"/>
                            <DataGridTextColumn Header="الاعتماد (بم/متى)" Binding="{Binding ApprovalText}" Width="200"/>
                            <DataGridTextColumn Header="مُفوتر (كجم)" Binding="{Binding InvoicedKg}" Width="86"/>
                            <DataGridTextColumn Header="متبقي للفوترة (كجم)" Binding="{Binding BillableKg}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
