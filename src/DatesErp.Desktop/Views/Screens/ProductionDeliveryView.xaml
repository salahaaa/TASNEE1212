<UserControl x:Class="DatesErp.Desktop.Views.Screens.ProductionDeliveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <!-- §B96: أوامر تسليم الإنتاج — تحرر من مدير الإنتاج داخل إدارة الإنتاج -->
    <DockPanel LastChildFill="True">
            <!-- رأس الأمر -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <Border Style="{StaticResource SecHeader}" Margin="-12,-12,-12,8">
                        <TextBlock Text="🏭 أمر تسليم إنتاج — المصدر: محضر فحص معتمد / خطة / إقفال خطة (الأخيران تجاوز بصلاحية وسبب)" FontSize="12" FontWeight="Bold" Foreground="#0A246A"/>
                    </Border>
                    <WrapPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="المصدر:" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="SourceTypeBox" Width="170" SelectionChanged="SourceType_Changed"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="مستند المصدر:" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="SourceDocBox" Width="330" SelectionChanged="SourceDoc_Changed"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="رقم الأمر (تلقائي):" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="DocNoBox" Width="150" IsReadOnly="True" Background="#F0F0F0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="تاريخ التسليم:" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="DateBox" Width="150"/>
                        </StackPanel>
                    </WrapPanel>
                    <WrapPanel Margin="0,6,0,0">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="سبب التجاوز (إجباري للخطة/الإقفال):" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="BypassBox" Width="420"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="ملاحظات:" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="NotesBox" Width="330"/>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- البنود -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <Border Style="{StaticResource SecHeader}" Margin="-12,-12,-12,8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="📋 البنود — عميل أو عدة عملاء · صنف أو أكثر (البند = أمر + صنف + دفعة + عميل)" FontSize="12" FontWeight="Bold" Foreground="#0A246A"/>
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button Content="⬇ تنزيل البنود من المصدر" Style="{StaticResource ErpButton}" Click="Download_Click"/>
                                <Button Content="كامل المتبقي للكل" Style="{StaticResource ErpButton}" Click="AllFull_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <DataGrid x:Name="ItemsGrid" Height="132" RowHeight="30" IsReadOnly="False" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="تضمين" Binding="{Binding Included, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                            <DataGridTextColumn Header="الأمر" Binding="{Binding OrderNumber}" Width="110" IsReadOnly="True"/>
                            <DataGridTextColumn Header="الصنف" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="الدفعة" Binding="{Binding LotCode}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="140" IsReadOnly="True"/>
                            <DataGridTextColumn Header="المتاح" Binding="{Binding Available}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="سُلِّم" Binding="{Binding Delivered}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="المتبقي" Binding="{Binding Remaining}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="كمية التسليم (كجم)" Binding="{Binding Qty, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                            <DataGridTextColumn Header="عبوات" Binding="{Binding Packages, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- سجل الأوامر -->
            <Border Style="{StaticResource WhiteCard}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="أوامر التسليم (نقر مزدوج للفتح)" FontWeight="Bold" FontSize="12" Foreground="#0A246A" Margin="0,0,0,6"/>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="بحث:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="RecSearchBox" Width="260"/>
                        <Button Content="🔍 بحث" Style="{StaticResource ErpButton}" Click="Search_Click" Margin="6,0,0,0"/>
                    </StackPanel>
                    <DataGrid x:Name="RecordsGrid" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="Records_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الرقم" Binding="{Binding DocNo}" Width="130"/>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding Date}" Width="100"/>
                            <DataGridTextColumn Header="المصدر" Binding="{Binding SourceAr}" Width="90"/>
                            <DataGridTextColumn Header="مستند المصدر" Binding="{Binding SourceNo}" Width="130"/>
                            <DataGridTextColumn Header="البنود" Binding="{Binding Lines}" Width="60"/>
                            <DataGridTextColumn Header="الكمية" Binding="{Binding Total}" Width="100"/>
                            <DataGridTextColumn Header="الحالة" Binding="{Binding StatusAr}" Width="100"/>
                            <DataGridTextColumn Header="الاستلام" Binding="{Binding ReceiptAr}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
    </DockPanel>
</UserControl>
