<UserControl x:Class="DatesErp.Desktop.Views.Screens.PlanningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <!-- §شاشة الخطط المحفوظة — عرض واطلاع فقط:
         جدول واحد للخطط المحفوظة، والنقر المزدوج على خطة يفتح نافذة تفاصيلها (قراءة فقط).
         لا نموذج اختيار أصناف ولا لوحات «بنود اليوم» / «حالة أيام الخطة» / «تقدم كل عميل». -->
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource WhiteCard}" Padding="10,6" Margin="8,8,8,4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📋 الخطط المحفوظة" FontWeight="Bold" FontSize="13" Foreground="#1F2937" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="نقر مزدوج على خطة لعرض تفاصيلها للاطلاع." FontSize="11.5" Foreground="#6B7280" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="NewPlanBtn" Content="➕ خطة جديدة" Style="{StaticResource ErpPrimaryButton}" Click="NewPlan_Click" Margin="0,0,6,0"/>
                    <Button x:Name="RefreshBtn" Content="🔄 تحديث" Style="{StaticResource ErpButton}" Click="Refresh_Click" Margin="0,0,6,0"/>
                    <TextBox x:Name="PlansSearchBox" Width="280" TextChanged="PlansSearch_Changed" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <DataGrid x:Name="PlansGrid" Margin="8,4,8,8" RowHeight="30" FontSize="13" ColumnHeaderHeight="36"
                  IsReadOnly="True" AutoGenerateColumns="False" MouseDoubleClick="PlansGrid_DoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="رقم الخطة" Binding="{Binding DocNo}" Width="130"/>
                <DataGridTextColumn Header="العنوان" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="الفترة" Binding="{Binding Period}" Width="170"/>
                <DataGridTextColumn Header="العملاء" Binding="{Binding Customers}" Width="70"/>
                <DataGridTextColumn Header="البنود" Binding="{Binding Items}" Width="60"/>
                <DataGridTextColumn Header="الكمية (كجم)" Binding="{Binding Qty}" Width="0.8*" MinWidth="100"/>
                <DataGridTextColumn Header="الحالة" Binding="{Binding StatusAr}" Width="*" MinWidth="130"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
