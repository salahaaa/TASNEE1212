<UserControl x:Class="DatesErp.Desktop.Views.Screens.ReceivingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             FlowDirection="RightToLeft">
    <!-- §بلا تمرير: الأقسام ثابتة أعلى وأسفل · الجدول الرئيسي يملأ الواجهة -->
    <DockPanel LastChildFill="True">
            <!-- بيانات السند -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <Border Style="{StaticResource SecHeader}" Margin="-12,-12,-12,8">
                        <TextBlock Text="📥 بيانات سند الاستلام" FontSize="12" FontWeight="Bold" Foreground="#0A246A"/>
                    </Border>
                    <TextBlock x:Name="DocState" Text="حالة المستند: مستند جديد — أدخل البيانات ثم اضغط حفظ" FontSize="12" FontWeight="Bold" Foreground="#14532D" Margin="0,0,0,8"/>
                    <WrapPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="العميل المورد *:" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CustomerBox" Width="240" DisplayMemberPath="CustomerName" SelectedValuePath="Id"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="رقم المستند (تلقائي):" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="DocNoBox" Width="170" IsReadOnly="True" Background="#F0F0F0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="تاريخ الوصول *:" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="ArrivalDate" Width="150"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="تاريخ الاستلام *:" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="ReceivedDate" Width="150"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="موظف الاستلام:" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="EmployeeBox" Width="200" DisplayMemberPath="FullName" SelectedValuePath="Id"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="رقم الحاوية/الشاحنة:" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ContainerBox" Width="180" ToolTip="مثال: CXLU-8841203" LostFocus="ContainerBox_LostFocus"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="🏬 مخزن الاستلام الفعلي:" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="WarehouseBox" Width="210" DisplayMemberPath="WarehouseNameAr" SelectedValuePath="Id"
                                      ToolTip="المخزن الذي وصلت إليه الحاوية فعلياً (الرئيسي / الخام 2 / الثلاجة...) — يقيَّد الوارد فيه عند الاعتماد"/>
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock x:Name="DuplicateWarn" TextWrapping="Wrap" Foreground="#B45309" FontWeight="Bold" FontSize="11" Margin="0,4,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- بنود الشحنة -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,8" DockPanel.Dock="Top">
                <StackPanel>
                    <Border Style="{StaticResource SecHeader}" Margin="-12,-12,-12,8">
                        <TextBlock Text="📦 بنود الشحنة الواردة — الاستلام للمواد الخام (001) فقط | وحدة الاستلام الأصلية محفوظة والكمية القياسية كجم (العدد × وزن الوحدة)" FontSize="12" FontWeight="Bold" Foreground="#0A246A" TextWrapping="Wrap"/>
                    </Border>
                    <WrapPanel>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="الصنف الخام (001) *:" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="ProductBox" Width="240" DisplayMemberPath="ProductNameAr" SelectedValuePath="Id"
                                      SelectionChanged="ProductBox_Changed"
                                      ToolTip="اختيار الصنف يعبئ عبوته الافتراضية ووزنها تلقائياً من بطاقة الصنف"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="الوحدة * (تُقرأ من الوحدات):" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="PackBox" Width="180" DisplayMemberPath="PackageNameAr" SelectedValuePath="Id"
                                      SelectionChanged="PackBox_Changed"
                                      ToolTip="اختيار العبوة يعبئ وزن العبوة تلقائياً — قابل للتعديل اليدوي"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="عدد الوحدات *:" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="PkgCountBox" Width="100" Text="0" TextChanged="Calc_Changed"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="وزن العبوة (كجم) *:" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="UnitWeightBox" Width="110" Text="0" TextChanged="Calc_Changed"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="إجمالي الوزن المحتسب:" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="CalcTotalBox" Width="130" IsReadOnly="True" Background="#F0F0F0" FontWeight="Bold" Foreground="#14532D"/>
                        </StackPanel>
                        <Button x:Name="AddItemBtn" Content="➕ إضافة البند" Style="{StaticResource ErpPrimaryButton}" VerticalAlignment="Bottom" Click="AddItem_Click"/>
                    </WrapPanel>

                    <DataGrid x:Name="ItemsGrid" Height="118" RowHeight="30" FontSize="13.5" Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="م" Binding="{Binding RowNo}" Width="42" IsReadOnly="True"/>
                            <DataGridTextColumn Header="رقم الصنف" Binding="{Binding ProductCode}" Width="105" IsReadOnly="True"/>
                            <DataGridTextColumn Header="اسم الصنف الخام" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="وحدة الاستلام الأصلية" Binding="{Binding ReceiptUnit}" Width="130" IsReadOnly="True"/>
                            <DataGridTextColumn Header="العبوة" Binding="{Binding PackName}" Width="140" IsReadOnly="True"/>
                            <DataGridTextColumn Header="العدد" Binding="{Binding PackageCount}" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="وزن العبوة (كجم)" Binding="{Binding UnitWeightKg}" Width="115" IsReadOnly="True"/>
                            <DataGridTextColumn Header="الإجمالي (كجم)" Binding="{Binding QtyKg}" Width="110" IsReadOnly="True"/>
                            <DataGridComboBoxColumn Header="حالة البند (جزئي)" SelectedItemBinding="{Binding Status, UpdateSourceTrigger=PropertyChanged}" Width="120">
                                <DataGridComboBoxColumn.ItemsSource>
                                    <x:Array Type="sys:String">
                                        <sys:String>مستلم</sys:String>
                                        <sys:String>مرفوض/تالف</sys:String>
                                        <sys:String>معلّق لاحقاً</sys:String>
                                    </x:Array>
                                </DataGridComboBoxColumn.ItemsSource>
                            </DataGridComboBoxColumn>
                            <DataGridTemplateColumn Header="حذف" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" Padding="4,0" Style="{StaticResource ErpDangerButton}" Click="RemoveItem_Click" Tag="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="إجمالي وزن الشحنة:" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="GrandTotal" Text="0 كجم" FontWeight="Bold" FontSize="14" Foreground="#14532D" Margin="8,0,0,0"/>
                        <TextBlock Text="  |  عدد البنود:" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ItemsCount" Text="0" FontWeight="Bold" FontSize="14" Foreground="#0A246A" Margin="8,0,0,0"/>
                        <TextBlock Text="  |  إجمالي العبوات (كراتين/سلال):" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PackagesTotal" Text="0" FontWeight="Bold" FontSize="14" Foreground="#92400E" Margin="8,0,0,0"/>
                        <TextBlock x:Name="ContainerSummary" Text="" FontWeight="Bold" FontSize="11" Foreground="#7C3AED" VerticalAlignment="Center" Margin="18,0,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="البيان والتفاصيل:" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="NotesBox" Width="700" HorizontalAlignment="Right" ToolTip="أدخل بيان أو تفاصيل الشحنة الواردة..."/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- حالة الاعتماد -->
            <Border x:Name="LockBanner" Background="#FEF3C7" BorderBrush="#D97706" BorderThickness="1" Padding="10" Margin="0,0,0,8" Visibility="Collapsed">
                <TextBlock Text="🔒 مقفل — أمر استلام معتمد (للتعديل: ألغِ الاعتماد بصلاحية)" Foreground="#92400E" FontWeight="Bold" FontSize="12"/>
            </Border>

            <!-- سجل أوامر الاستلام -->
            <Border Style="{StaticResource WhiteCard}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="نتائج البحث — سندات الاستلام (تظهر بعد الضغط على «بحث / القائمة»، نقر مزدوج يفتح السند في هذه الواجهة)" FontWeight="Bold" FontSize="12" Foreground="#0A246A" Margin="0,0,0,6"/>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="🔍 بحث وفلترة:" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="ShipsSearchBox" Width="340" TextChanged="ShipsSearch_Changed" VerticalAlignment="Center"/>
                    </StackPanel>
                    <DataGrid x:Name="ShipGrid" RowHeight="30" FontSize="13.5" ColumnHeaderHeight="38" MouseDoubleClick="ShipGrid_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم السند" Binding="{Binding DocNo}" Width="140"/>
                            <DataGridTextColumn Header="العميل" Binding="{Binding Customer}" Width="*"/>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding Date}" Width="110"/>
                            <DataGridTextColumn Header="الوزن (كجم)" Binding="{Binding Weight}" Width="110"/>
                            <DataGridTextColumn Header="الحالة" Binding="{Binding StatusAr}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
    </DockPanel>
</UserControl>
