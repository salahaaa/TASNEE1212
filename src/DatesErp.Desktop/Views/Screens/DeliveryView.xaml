<UserControl x:Class="DatesErp.Desktop.Views.Screens.DeliveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <!-- §بلا تمرير: الأقسام ثابتة أعلى وأسفل · الجدول الرئيسي يملأ الواجهة -->
    <DockPanel LastChildFill="True">
            <!-- رأس السند -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <Border Style="{StaticResource SecHeader}" Margin="-12,-12,-12,8">
                        <TextBlock Text="🚛 إذن خروج وتسليم بضاعة للعملاء — من رصيد العميل في مخزن التام فقط" FontSize="12" FontWeight="Bold" Foreground="#0A246A"/>
                    </Border>
                    <WrapPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="العميل:" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CustomerBox" Width="260" DisplayMemberPath="CustomerName" SelectedValuePath="Id" SelectionChanged="Customer_Changed"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="رقم السند (تلقائي):" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="DocNoBox" Width="170" IsReadOnly="True" Background="#F0F0F0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="تاريخ التسليم:" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="DateBox" Width="150"/>
                        </StackPanel>
                        <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" Padding="10,6" VerticalAlignment="Bottom">
                            <TextBlock x:Name="BalanceChip" Text="رصيد العميل: —" FontWeight="Bold" FontSize="12" Foreground="#166534"/>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- رصيد العميل -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <Border Style="{StaticResource SecHeader}" Margin="-12,-12,-12,8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="📊 رصيد العميل المتاح في مخزن التام" FontSize="12" FontWeight="Bold" Foreground="#0A246A"/>
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button Content="⬇ تسليم كامل الكمية المتاحة" Style="{StaticResource ErpButton}" Click="DeliverAll_Click"/>
                                <Button Content="🗑 حذف السطر المحدد" Style="{StaticResource ErpDangerButton}" Click="RemoveRow_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <DataGrid x:Name="BalanceGrid" Height="112" RowHeight="28" MouseDoubleClick="Balance_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الصنف" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="الوحدة" Binding="{Binding Unit}" Width="110"/>
                            <DataGridTextColumn Header="العبوة" Binding="{Binding PackName}" Width="120"/>
                            <DataGridTextColumn Header="الدفعة" Binding="{Binding LotCode}" Width="130"/>
                            <DataGridTextColumn Header="الكراتين" Binding="{Binding Packages}" Width="80"/>
                            <DataGridTextColumn Header="الوزن المكافئ (كجم)" Binding="{Binding Qty}" Width="120"/>
                            <DataGridTextColumn Header="حالة الفحص" Binding="{Binding QcStatus}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="نقر مزدوج على سطر الرصيد لإضافته إلى بنود التسليم" FontSize="11" Foreground="#555" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- بنود التسليم -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <Border Style="{StaticResource SecHeader}" Margin="-12,-12,-12,8">
                        <TextBlock Text="📋 بنود إذن التسليم" FontSize="12" FontWeight="Bold" Foreground="#0A246A"/>
                    </Border>
                    <DataGrid x:Name="ItemsGrid" Height="112" RowHeight="28" IsReadOnly="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الصنف" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="الوحدة" Binding="{Binding Unit}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="العبوة" Binding="{Binding PackName}" Width="110" IsReadOnly="True"/>
                            <DataGridTextColumn Header="الدفعة" Binding="{Binding LotCode}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="الكراتين *" Binding="{Binding Packages, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                            <DataGridTextColumn Header="الوزن المكافئ (كجم)" Binding="{Binding Qty}" Width="120" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- سجل التسليمات -->
            <Border Style="{StaticResource WhiteCard}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="سندات تسليم العملاء (نقر مزدوج للفتح)" FontWeight="Bold" FontSize="12" Foreground="#0A246A" Margin="0,0,0,6"/>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="🔍 بحث وفلترة:" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="DelivSearchBox" Width="340" TextChanged="DelivSearch_Changed" VerticalAlignment="Center"/>
                    </StackPanel>
                    <DataGrid x:Name="DeliveriesGrid" RowHeight="30" FontSize="13.5" ColumnHeaderHeight="38" MouseDoubleClick="DeliveriesGrid_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الرقم" Binding="{Binding DocNo}" Width="130"/>
                            <DataGridTextColumn Header="العميل" Binding="{Binding Customer}" Width="*"/>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding Date}" Width="110"/>
                            <DataGridTextColumn Header="الكراتين" Binding="{Binding Packages}" Width="90"/>
                            <DataGridTextColumn Header="الوزن المكافئ (كجم)" Binding="{Binding Qty}" Width="120"/>
                            <DataGridTextColumn Header="الحالة" Binding="{Binding StatusAr}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
    </DockPanel>
</UserControl>
