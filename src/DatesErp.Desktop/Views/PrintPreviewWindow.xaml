<Window x:Class="DatesErp.Desktop.Views.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="معاينة قبل الطباعة" Height="700" Width="1050"
        WindowStartupLocation="CenterOwner" WindowState="Maximized"
        FlowDirection="RightToLeft" Background="#ECE9D8">
    <DockPanel>
        <!-- §شريط أدوات المعاينة: طباعة + تصدير PDF + تكبير/تصغير + ملاءمة العرض -->
        <Border DockPanel.Dock="Top" Background="#ECE9D8" BorderBrush="#7F9DB9" BorderThickness="0,0,0,1" Padding="8,5">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="PreviewTitle" FontWeight="Bold" FontSize="13" Foreground="#0A246A" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button Content="🖨️ طباعة الآن" Style="{StaticResource ErpApproveButton}" Click="Print_Click" Padding="18,5"/>
                <Button x:Name="PdfBtn" Content="📄 تصدير PDF" Style="{StaticResource ErpPrimaryButton}" Click="Pdf_Click" Padding="14,5" Margin="6,0,0,0" Visibility="Collapsed" ToolTip="حفظ نسخة PDF من هذا النموذج"/>
                <Separator Margin="10,0"/>
                <TextBlock Text="🔍 تكبير:" VerticalAlignment="Center" FontWeight="Bold" FontSize="11.5" Margin="0,0,4,0"/>
                <Button Content="−" Width="26" Click="ZoomOut_Click" FontSize="14" FontWeight="Bold" Padding="0,-2,0,0"/>
                <Slider x:Name="ZoomSlider" Width="140" Minimum="40" Maximum="300" Value="100"
                        VerticalAlignment="Center" Margin="6,0" ValueChanged="Zoom_Changed"
                        TickFrequency="20" IsSnapToTickEnabled="False" SmallChange="10" LargeChange="40"/>
                <Button Content="+" Width="26" Click="ZoomIn_Click" FontSize="14" FontWeight="Bold" Padding="0,-2,0,0"/>
                <TextBlock x:Name="ZoomLabel" Text="100%" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" Margin="6,0,12,0" Foreground="#0A246A"/>
                <Button Content="↔ ملاءمة العرض" Style="{StaticResource ErpButton}" Click="Fit_Click" Padding="12,4" FontSize="11"/>
                <Button Content="100%" Style="{StaticResource ErpButton}" Click="Reset_Click" Padding="10,4" FontSize="11" Margin="4,0,0,0"/>
                <Button Content="إغلاق المعاينة" Style="{StaticResource ErpButton}" Click="Close_Click" Padding="18,5" Margin="16,0,0,0"/>
                <TextBlock Text="معاينة حية مطابقة للمطبوع — راجع ثم اطبع أو صدّر PDF" FontSize="12" Foreground="#6B7280"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>
        </Border>
        <!-- §صفحة المعاينة — FlowDocumentScrollViewer مع تكبير/تصغير حي -->
        <Border Background="#8EA2B5" Padding="18">
            <Border Background="White" BorderBrush="#5C768D" BorderThickness="1" Padding="26" ClipToBounds="False">
                <FlowDocumentScrollViewer x:Name="Viewer" Background="White"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto"/>
            </Border>
        </Border>
    </DockPanel>
</Window>
