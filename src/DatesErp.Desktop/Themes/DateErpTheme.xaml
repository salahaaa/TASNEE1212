<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════
         هوية Date ERP البصرية (Onyx Classic — إصدار راقي):
         كحلي عميق #0A246A | ذهبي #C9A227 | أخضر نخيلي #14532D | بيج دافئ #ECE9D8
         مستطيلات بإطار خارجي واضح، أزرار موحدة المسافات بلا تداخل،
         قوائم وجداول واسعة لا تخرج بياناتها عن النطاق.
         ═══════════════════════════════════════════════════════════════ -->
    <Color x:Key="PrimaryColor">#14532D</Color>
    <Color x:Key="PrimaryDarkColor">#0B3D1F</Color>
    <Color x:Key="AccentColor">#C9A227</Color>
    <Color x:Key="LightBgColor">#ECE9D8</Color>
    <Color x:Key="BorderColor">#7F9DB9</Color>
    <Color x:Key="DangerColor">#DC2626</Color>
    <Color x:Key="SuccessColor">#16A34A</Color>
    <Color x:Key="NavyColor">#0A246A</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="LightBgBrush" Color="{StaticResource LightBgColor}"/>
    <SolidColorBrush x:Key="BorderBrushStd" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="NavyBrush" Color="{StaticResource NavyColor}"/>
    <SolidColorBrush x:Key="GrayTextBrush" Color="#5F6368"/>

    <!-- §معيار الواجهات الموحد: خط رسمي واحد لجميع العناصر (عناوين/حقول/أزرار/جداول/رسائل) -->
    <FontFamily x:Key="HeadFont">Segoe UI, Tahoma, Arial</FontFamily>
    <FontFamily x:Key="BodyFont">Segoe UI, Tahoma, Arial</FontFamily>
    <system:Double x:Key="UiFontSize" xmlns:system="clr-namespace:System;assembly=mscorlib">12</system:Double>

    <!-- ═══ النوافذ: خلفية موحدة وخط موحد (إطار بصري واحد لكل النظام) ═══ -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="#ECE9D8"/>
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- ═══ §19/§20 — معيار الجداول الموحد: حدود واضحة، خطوط فصل، رؤوس واضحة،
         ارتفاع صف مناسب، تمييز الصف المحدد، تمرير عند كثرة البيانات ═══ -->
    <Style TargetType="DataGrid">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#7F9DB9"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="GridLinesVisibility" Value="All"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#C9C2AC"/>
        <Setter Property="VerticalGridLinesBrush" Value="#DAD4C0"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeight" Value="32"/>
        <Setter Property="ColumnHeaderHeight" Value="32"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="AlternationCount" Value="2"/>
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#0A246A"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Padding" Value="8,5"/>
                    <Setter Property="BorderBrush" Value="#7F9DB9"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="HorizontalContentAlignment" Value="Right"/>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="CellStyle">
            <Setter.Value>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="6,3"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#C9A227"/>
                            <Setter Property="Foreground" Value="#1F2937"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="RowStyle">
            <Setter.Value>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <Trigger Property="AlternationIndex" Value="1">
                            <Setter Property="Background" Value="#F7F4EA"/>
                        </Trigger>
                        <!-- §B89: إبراز الصف تحت المؤشر — قبل المحدد حتى لا يغلبه -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#E8EEF7"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#F3EAC8"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ §23 — معيار الحقول الموحد: مساحة مناسبة لا تخفي المحتوى ═══ -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="5,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="#7F9DB9"/>
        <Setter Property="Background" Value="White"/>
        <!-- §B89: إطار التركيز — الحقل النشط يُعرف فوراً بإطار كحلي -->
        <Setter Property="Validation.ErrorTemplate">
            <Setter.Value>
                <ControlTemplate>
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Right" Foreground="#DC2626" FontWeight="Bold" FontSize="12" Margin="4,0,0,0" Text="⚠"
                                   ToolTip="{Binding ElementName=adorner, Path=AdornedElement.(Validation.Errors)[0].ErrorContent}"/>
                        <Border BorderBrush="#DC2626" BorderThickness="1.5" CornerRadius="2">
                            <AdornedElementPlaceholder x:Name="adorner"/>
                        </Border>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="#1D4ED8"/>
                <Setter Property="BorderThickness" Value="1.8"/>
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
                <Setter Property="Background" Value="#F1F5F9"/>
                <Setter Property="Foreground" Value="#334155"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- §B90 — حواف الحقول الموحدة (التسطير المهني): كل حقل إدخال بإطار #7F9DB9 وإطار تركيز كحلي -->
    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="#7F9DB9"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="White"/>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="#1D4ED8"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DatePicker">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="BorderBrush" Value="#7F9DB9"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="White"/>
    </Style>
    <Style TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="5,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="#7F9DB9"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="White"/>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    </Style>

    <!-- §B90 — القوائم: إطار موحد + عنصر محدد كحلي واضح (خصائص ومحفزات فقط — بلا قوالب، آمن للافتراضي) -->
    <Style TargetType="ListBox">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="BorderBrush" Value="#7F9DB9"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="White"/>
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="6,5"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#E8EEF7"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#0A246A"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══ §B82 — أزرار واضحة مشبعة: كل نوع يُعرف من لونه فوراً ═══
         محايد = أبيض دافئ بإطار واضح | رئيسي = كحلي مصمت | اعتماد = أخضر مصمت | خطر = أحمر مصمت
         نص أبيض على المصمتة — انتهى عهد الباستيل الباهت المتشابه. المعطَّل رمادي صريح. -->

    <!-- الزر المحايد (إجراءات ثانوية): أبيض دافئ بإطار مقروء وحدود واضحة عند المرور -->
    <Style x:Key="ErpButton" TargetType="Button">
        <Setter Property="Background" Value="#F1EEDF"/>
        <Setter Property="Foreground" Value="#1F2937"/>
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="Margin" Value="3,2"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderBrush" Value="#5B7595"/>
        <Setter Property="BorderThickness" Value="1.2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"
                            Padding="{TemplateBinding Padding}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FFFFFF" Offset="0"/>
                                <GradientStop Color="#E7E2CD" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#C9A227"/>
                            <Setter TargetName="bd" Property="BorderThickness" Value="1.6"/>
                            <Setter TargetName="bd" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFDF4" Offset="0"/>
                                        <GradientStop Color="#F5EDCF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#DFD5B2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="#D8D4C5"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="#B4AF9E"/>
                            <Setter Property="Foreground" Value="#8B8574"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- الزر الرئيسي (حفظ/بحث/إنشاء): كحلي مصمت بنص أبيض — أعلى hierarchie بصرية -->
    <Style x:Key="ErpPrimaryButton" TargetType="Button" BasedOn="{StaticResource ErpButton}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#061845"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"
                            Padding="{TemplateBinding Padding}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#16418F" Offset="0"/>
                                <GradientStop Color="#0A246A" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#C9A227"/>
                            <Setter TargetName="bd" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#2158B8" Offset="0"/>
                                        <GradientStop Color="#123A8F" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#061845"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="#D8D4C5"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="#B4AF9E"/>
                            <Setter Property="Foreground" Value="#8B8574"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- زر الاعتماد/التأكيد: أخضر مصمت بنص أبيض -->
    <Style x:Key="ErpApproveButton" TargetType="Button" BasedOn="{StaticResource ErpButton}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#14532D"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"
                            Padding="{TemplateBinding Padding}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#17A94C" Offset="0"/>
                                <GradientStop Color="#15803D" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#C9A227"/>
                            <Setter TargetName="bd" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#22C55E" Offset="0"/>
                                        <GradientStop Color="#17A94C" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#14532D"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="#D8D4C5"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="#B4AF9E"/>
                            <Setter Property="Foreground" Value="#8B8574"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- زر الخطر (حذف/إلغاء): أحمر مصمت بنص أبيض — كان بيجاً باهتاً بنص أحمر -->
    <Style x:Key="ErpDangerButton" TargetType="Button" BasedOn="{StaticResource ErpButton}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#7F1D1D"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"
                            Padding="{TemplateBinding Padding}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#E02D2D" Offset="0"/>
                                <GradientStop Color="#B91C1C" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#FCA5A5"/>
                            <Setter TargetName="bd" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#F04848" Offset="0"/>
                                        <GradientStop Color="#DC2626" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#7F1D1D"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="#D8D4C5"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="#B4AF9E"/>
                            <Setter Property="Foreground" Value="#8B8574"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- أزرار قديمة للتوافق -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ErpApproveButton}"/>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ErpButton}"/>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ErpDangerButton}"/>
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ErpPrimaryButton}"/>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
        <Setter Property="Foreground" Value="#1F2937"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0,6,0,2"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#0A246A"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- §رأس أعمدة التقارير: خط أكبر وواضح — التقرير يُقرأ مطبوعاً وعلى الشاشة -->
    <Style x:Key="ReportHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#0A246A"/>
        <Setter Property="Background" Value="#EFEDE0"/>
        <Setter Property="Padding" Value="8,7"/>
        <Setter Property="BorderBrush" Value="#C9C4AE"/>
        <Setter Property="BorderThickness" Value="0,0,1,2"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="TextBlock.TextWrapping" Value="Wrap"/>
    </Style>

    <!-- رأس قسم: خلفية فاتحة أنيقة مع خط ذهبي سفلي (هوية موحدة + بقاء النصوص مقروءة) -->
    <Style x:Key="SecHeader" TargetType="Border">
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="BorderBrush" Value="#C9A227"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#EFEDE0" Offset="0"/>
                    <GradientStop Color="#E2DFCE" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ البطاقات: مستطيل خارجي واضح + ظل خفيف (لا تداخل ولا خروج عن النطاق) ═══ -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="#F7F5EC"/>
        <Setter Property="BorderBrush" Value="#7F9DB9"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.18" Color="#0A246A"/>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="WhiteCard" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#7F9DB9"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.15" Color="#0A246A"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ عنصر القائمة الجانبية (كحلي داكن — المعتمد) ═══ -->
    <Style x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="#CBD5E1"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}" Margin="0,1" CornerRadius="6">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#14FFFFFF"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#40CA8A04"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="#CA8A04"/>
                            <Setter TargetName="bd" Property="BorderThickness" Value="1.5"/>
                            <Setter Property="Foreground" Value="#FEF08A"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="BorderBrush" Value="#3A5A8C"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0A246A" Offset="0"/>
                    <GradientStop Color="#2B4C8C" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ شريط الحالة ═══ -->
    <Style x:Key="StatusText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#E6FFFA"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
        <Setter Property="Margin" Value="12,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- شارة حالة الوثيقة -->
    <Style x:Key="StatusBadge" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="6,1"/>
    </Style>

</ResourceDictionary>
